# Backend (apps/server) runtime config.
# Production copy: /opt/immortalclaw/server.env on the Singapore VPS.
# Auth and world state are stored in the SQLite file below. No Supabase keys are required.
#
# Local `npm run dev:server` can omit this file. The process then listens on
# port 8787 and allows http://localhost:5173.

PORT=8788
DB_PATH=/opt/immortalclaw/data/world.sqlite
# Public site origin. Apache serves the SPA and the API on this same origin.
FRONTEND_ORIGIN=https://claw.archim.top
# Steps advanced per 60s auto-tick (clamped 1..20).
WORLD_TICK_STEPS=1
# Long random token guarding POST /internal/reset-storage.
# Generate with: openssl rand -hex 24
# Do not commit a real token.
WORLD_RESET_TOKEN=change-me-to-a-long-random-token
