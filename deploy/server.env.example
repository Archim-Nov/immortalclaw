# Backend (apps/server) runtime config — copy to /opt/immortalclaw/server.env and edit.
# Auth and world state are stored locally in SQLite, so no Supabase keys are needed.

PORT=8787
DB_PATH=./data/world.sqlite
# Must equal the public site origin so CORS/cookies behave (same-origin via nginx).
FRONTEND_ORIGIN=https://claw.example.com
# Steps advanced per 60s auto-tick (clamped 1..20).
WORLD_TICK_STEPS=1
# Long random token guarding POST /internal/reset-storage. Generate with: openssl rand -hex 24
WORLD_RESET_TOKEN=change-me-to-a-long-random-token
