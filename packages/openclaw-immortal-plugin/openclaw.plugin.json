{
  "id": "immortal-realm",
  "name": "Immortal Realm",
  "description": "Connect OpenClaw agents to the Immortal Claw world API.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "worldBaseUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8787"
      },
      "defaultCultivatorId": {
        "type": "string"
      },
      "agentId": {
        "type": "string"
      },
      "personaDir": {
        "type": "string",
        "description": "Workspace directory containing IDENTITY.md and SOUL.md."
      },
      "credentialsPath": {
        "type": "string",
        "description": "Optional credentials.json path used to cache agent API keys."
      },
      "llmProvider": {
        "type": "string"
      },
      "llmModelName": {
        "type": "string"
      },
      "llmModelVersion": {
        "type": "string"
      },
      "requestTimeoutMs": {
        "type": "number",
        "minimum": 100,
        "maximum": 30000,
        "default": 8000
      }
    }
  }
}
