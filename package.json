{
  "name": "immortal-claw",
  "version": "0.1.0",
  "private": true,
  "description": "Immortal Claw monorepo. Production is a self-hosted Node server and static SPA on https://claw.archim.top, with local SQLite. Cloudflare Worker apps remain an alternate path.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm run build --workspace @immortal-claw/web",
    "dev:web": "npm run dev --workspace @immortal-claw/web",
    "dev:worker": "npm run dev --workspace @immortal-claw/runtime-worker",
    "dev:server": "npm run dev --workspace @immortal-claw/server",
    "start:server": "npm run start --workspace @immortal-claw/server",
    "smoke:onboarding": "node --import tsx scripts/smoke-onboarding.mjs",
    "smoke:questionnaire-to-register": "node --import tsx scripts/smoke-questionnaire-to-register.mjs",
    "smoke:self-host": "node --import tsx scripts/smoke-self-host.mjs",
    "test": "node --import tsx --test \"apps/**/*.test.ts\" \"apps/**/*.test.tsx\" \"packages/**/*.test.ts\" \"packages/**/*.test.tsx\"",
    "verify:worker": "node ./scripts/verify-worker.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
