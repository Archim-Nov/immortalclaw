{
  "name": "immortal-claw",
  "version": "0.1.0",
  "private": true,
  "description": "Immortal Claw monorepo with a Cloudflare Pages frontend, a Cloudflare Worker runtime, and Supabase persistence.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm run build --workspace @immortal-claw/web",
    "dev:api": "tsx apps/world-api/src/server.ts",
    "dev:legacy-api": "tsx apps/world-api/src/server.ts",
    "dev:legacy-worker": "tsx apps/world-worker/src/worker.ts",
    "dev:web": "npm run dev --workspace @immortal-claw/web",
    "dev:worker": "npm run dev --workspace @immortal-claw/runtime-worker",
    "test": "node --import tsx --test \"apps/**/*.test.ts\" \"apps/**/*.test.tsx\" \"packages/**/*.test.ts\" \"packages/**/*.test.tsx\"",
    "verify:worker": "node ./scripts/verify-worker.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
